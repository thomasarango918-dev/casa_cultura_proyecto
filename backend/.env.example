# =============================================================================
#  backend/.env.example  -  Plantilla (SÍ se sube a GitHub, sin claves reales)
#  Cópiela como backend/.env y complete los valores.
# =============================================================================

# ---- Aplicación -------------------------------------------------------------
ENVIRONMENT=development

# ---- Base de datos (PostgreSQL local) ---------------------------------------
# Formato: postgresql+psycopg2://USUARIO:CONTRASEÑA@SERVIDOR:PUERTO/BASE
# Reemplace tu_clave_postgres por la contraseña del usuario postgres.
# Si la contraseña tiene @ : / # % escríbalos codificados (@ = %40, # = %23, % = %25).
DATABASE_URL=postgresql+psycopg2://postgres:AdminSp2026*/@localhost:5432/casacultura
DB_ECHO=false

# ---- Seguridad / JWT --------------------------------------------------------
# Genere una con:  python -c "import secrets; print(secrets.token_hex(32))"
# Si se cambia, todas las sesiones abiertas se cierran.
JWT_SECRET_KEY=fbc2aea53cccaa8d7645e9f11b9ff7cead38e19b7e99cb7e19f2aac3a0004782
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ---- CORS (lista JSON) ------------------------------------------------------
CORS_ORIGINS=["http://localhost:5173"]

# ---- Correo electrónico (ver GUIA_RESEND_API.md) ----------------------------
# Vacía o con valor de ejemplo = los correos solo se escriben en la consola.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Casa de la Cultura <onboarding@resend.dev>
EMAIL_ADMIN=backoffice@ejemplo.com

# Alternativa por SMTP (solo se usa si RESEND_API_KEY está vacía).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_SSL=false

# ---- Recuperación de contraseña ---------------------------------------------
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_EXPIRE_MINUTES=15
